# Secret values belong in the deployment platform's secret manager.
APP_ENV=staging
DEBUG=false
PUBLIC_BASE_URL=https://api.staging.example.com
DATABASE_URL=postgresql+psycopg2://woven:REPLACE@db:5432/woven
SECRET_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
REFRESH_TOKEN_PEPPER=REPLACE_WITH_ANOTHER_32_PLUS_RANDOM_SECRET
APPLE_CLIENT_ID=com.example.Woven
CORS_ORIGINS=https://staging.example.com
TRUSTED_HOSTS=api.staging.example.com
STORAGE_BACKEND=object
OBJECT_STORAGE_ENDPOINT=https://objects.example.com
OBJECT_STORAGE_BUCKET=woven-staging-ciphertext
OBJECT_STORAGE_REGION=us-west-2
OBJECT_STORAGE_ACCESS_KEY=REPLACE
OBJECT_STORAGE_SECRET_KEY=REPLACE
ENFORCE_DEVICE_SIGNATURES=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PAIR_PER_MINUTE=120
