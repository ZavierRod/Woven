# Copy to .env for explicit local development. Never commit populated secrets.
APP_ENV=local
DEBUG=true
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./woven_local.db
SECRET_KEY=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret
GOOGLE_CLIENT_ID=
CORS_ORIGINS=
TRUSTED_HOSTS=
STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=./storage/media
ENFORCE_DEVICE_SIGNATURES=false
